# ---- Brain (the LLM that is Grik) ----
ANTHROPIC_API_KEY=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
GRIK_BRAIN_MODEL=claude-sonnet-4-6

# ---- Wake word (OpenWakeWord — fully open source, no account needed) ----
# Leave GRIK_WAKE_MODELS blank to use the bundled "hey_jarvis" model.
# To train a custom "Grik" wake word, see:
#   https://github.com/dscripka/openWakeWord#training-new-models
GRIK_WAKE_MODELS=
GRIK_WAKE_FRAMEWORK=onnx
GRIK_WAKE_SENSITIVITY=0.5

# ---- Speech to text (local, faster-whisper) ----
GRIK_STT_MODEL=base.en
GRIK_STT_DEVICE=auto

# ---- Text to speech (ElevenLabs — the Celtic voice) ----
ELEVENLABS_API_KEY=sk_5a3e1b42de44e9e28ca8fdf8d4175dfa544d662efc45af89
GRIK_VOICE_ID=1akQNyt9mMzTni2Y99lv     # pick/design an Irish or Scottish voice in your library
GRIK_TTS_MODEL=eleven_turbo_v2_5

# ---- Agent orchestration ----
GRIK_DOCKER_NETWORK=grik-net
GRIK_BASE_AGENT_IMAGE=grik-base-agent:latest
GRIK_ALLOW_PROVISIONING=true
GRIK_AGENT_TIMEOUT=120

# ---- Services the media agent talks to ----
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# ---- Home Assistant (smart-home agent) ----
# Generate a long-lived access token at: HA → Profile → Long-Lived Access Tokens
HASS_URL=http://homeassistant:8123
HASS_TOKEN=

# ---- n8n (workflow automation agent) ----
# Generate an API key at: n8n → Settings → API → API Keys
N8N_URL=http://n8n:5678
N8N_API_KEY=

# ---- Web agent search backend ----
SEARX_URL=http://searxng:8080

# ---- Web interface ----
GRIK_WEB_MODE=false
GRIK_WEB_HOST=0.0.0.0
GRIK_WEB_PORT=7777

# ---- Dev ----
GRIK_TEXT_MODE=true
