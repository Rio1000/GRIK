# ---- Brain (the LLM that is Wullie) ----
ANTHROPIC_API_KEY=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
WULLIE_BRAIN_MODEL=claude-sonnet-4-6

# ---- Wake word (OpenWakeWord — fully open source, no account needed) ----
# Leave WULLIE_WAKE_MODELS blank to use the bundled "hey_jarvis" model.
# To train a custom "Wullie" wake word, see:
#   https://github.com/dscripka/openWakeWord#training-new-models
WULLIE_WAKE_MODELS=
WULLIE_WAKE_FRAMEWORK=onnx
WULLIE_WAKE_SENSITIVITY=0.5

# ---- Speech to text (local, faster-whisper) ----
WULLIE_STT_MODEL=base.en
WULLIE_STT_DEVICE=auto

# ---- Text to speech ----
# piper | elevenlabs | browser | off
# piper      = local neural TTS (Scottish voice at ./voices/en_GB-alba-medium.onnx)
# elevenlabs = paid cloud voice (library voices need a paid plan)
# browser    = OS/browser's built-in Web Speech API
# off        = no TTS
WULLIE_TTS_MODE=piper
WULLIE_PIPER_VOICE_PATH=/home/spark/GRIK/voices/en_GB-vctk-medium.onnx
# Speaker key from voice's .onnx.json. Scottish males in VCTK: p241, p272, p285. Blank = default speaker.
WULLIE_PIPER_SPEAKER=p241
ELEVENLABS_API_KEY=sk_5a3e1b42de44e9e28ca8fdf8d4175dfa544d662efc45af89
WULLIE_VOICE_ID=PVbpzAqIaShtyQTzSeuk
WULLIE_TTS_MODEL=elevenlabs

# ---- Brain persistent memory  ----
WULLIE_MEMORY_PATH=~/.wullie/memory.md

# ---- Agent orchestration ----
WULLIE_DOCKER_NETWORK=wullie-net
WULLIE_BASE_AGENT_IMAGE=wullie-base-agent:latest
WULLIE_ALLOW_PROVISIONING=true
WULLIE_AGENT_TIMEOUT=120

# ---- Services the media agent talks to ----
RADARR_URL=http://radarr:7878
RADARR_API_KEY=a26ae779fa8e47f4840f29ae9228e88f
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# ---- Home Assistant (smart-home agent) ----
