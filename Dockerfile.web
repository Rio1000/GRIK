FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir anthropic>=0.40 httpx>=0.27 docker>=7.1 \
    fastapi>=0.110 uvicorn[standard]>=0.29 websockets>=12 \
    python-multipart>=0.0.9 \
    elevenlabs>=1.0 faster-whisper>=1.0
COPY grik ./grik
ENV GRIK_WEB_MODE=true
EXPOSE 7777
CMD ["python", "-m", "grik.main"]
